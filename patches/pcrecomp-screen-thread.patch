 /* The window's title, for a host that shows what is playing (a mod). */
-void hle_screen_title(const char *title) { if (g_win) SDL_SetWindowTitle(g_win, title); }
+void hle_screen_title(const char *title) {
+    if (!g_win || !title) return;
+    if (pthread_equal(pthread_self(), g_video_thread)) SDL_SetWindowTitle(g_win, title);
+    else {
+        pthread_mutex_lock(&g_ui_pending_lock);
+        snprintf(g_next_title, sizeof g_next_title, "%s", title);
+        g_pending_title = 1;
+        pthread_mutex_unlock(&g_ui_pending_lock);
+    }
+}
 
