+static int ini_section_match(const char *line, const char *section) {
+    while (*line == ' ' || *line == '\t') ++line;
+    if (*line != '[') return -1;
+    const char *end = strchr(++line, ']');
+    if (!end) return -1;
+    return (size_t)(end - line) == strlen(section) &&
+           !strncasecmp(line, section, (size_t)(end - line));
+}
+static int ini_key_match(const char *line, const char *key) {
+    while (*line == ' ' || *line == '\t') ++line;
+    if (*line == ';' || *line == '#') return 0;
+    const char *eq = strchr(line, '=');
+    if (!eq) return 0;
+    const char *end = eq;
+    while (end > line && (end[-1] == ' ' || end[-1] == '\t')) --end;
+    return (size_t)(end - line) == strlen(key) &&
+           !strncasecmp(line, key, (size_t)(end - line));
