+/* In-process Win32 sharing checks. Guest calls are serialized by the
+ * machine lock. Identity is the opened inode, not a case-sensitive pathname.
+ * Native processes and unrelated host I/O do not participate in this table. */
+typedef struct hfile {
+    int fd;
+    dev_t device;
+    ino_t inode;
+    uint32_t access, share; /* read=1, write=2, delete=4 */
+    struct hfile *next;
+} hfile;
+static hfile *g_open_files;
+static int sharing_conflict(const struct stat *st, uint32_t access, uint32_t share) {
+    for (hfile *f = g_open_files; f; f = f->next)
+        if (f->device == st->st_dev && f->inode == st->st_ino &&
+            ((access & ~f->share) || (f->access & ~share))) return 1;
+    return 0;
+}
+static void file_closer(void *o) {
+    hfile *f = (hfile *)o, **link = &g_open_files;
+    while (*link && *link != f) link = &(*link)->next;
+    if (*link) *link = f->next;
+    if (f->fd > 2) close(f->fd);
+    free(f);
+}
 
