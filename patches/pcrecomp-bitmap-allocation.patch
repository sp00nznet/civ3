--- gdi32.c
+++ gdi32.c
@@ -14,6 +14,7 @@
 #include <stdlib.h>
 #include <string.h>
 #include "win32hle.h"
+#include "bitmap_layout.h"
 
 /* The destination the game's blits land on: a host-owned ARGB8888 framebuffer.
  * The host (or the selftest) sets it; user32's present copies it to a texture. */
@@ -38,31 +39,50 @@
 #define MAX_DIBS 8192
 static struct { uint32_t h; uint32_t *bits; int w, h_abs, topdown; } g_dibs[MAX_DIBS];
 static int g_dib_n;
-static uint32_t g_next_handle = 0xD1B00001u;
 
 /* A DIB section for a BITMAPINFO (header, then masks or colour table): its
  * pixels in guest memory, *bits_out pointing at them; the HBITMAP, or 0.
  * CreateDIBSection, and LoadImageA's bitmaps (user32.c). */
+static uint32_t bitmap_u32(const uint8_t *p) {
+    return (uint32_t)p[0] | (uint32_t)p[1] << 8 | (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
 uint32_t hle_gdi_dib_section(const uint8_t *bmi, uint32_t **bits_out) {
-    int w = bi_w(bmi), h = bi_h(bmi), bpp = bi_bpp(bmi);
-    int hab = h < 0 ? -h : h;
-    /* any depth gets its pixels (rows are DWORD-aligned), and a bitmap object
-     * (gdidc.c) a DC can select and blit from: 16bpp is 5-6-5 only when its
-     * BI_BITFIELDS masks say so, and 8bpp and below bring a colour table */
-    uint32_t *bits = (uint32_t *)hle_alloc((uint32_t)((w * bpp + 31) / 32 * hab + 1) * 4u);   /* guest memory: the guest draws into it */
-    uint32_t size = (uint32_t)(bmi[0] | bmi[1] << 8), comp = (uint32_t)(bmi[16] | bmi[17] << 8);
-    uint32_t used = (uint32_t)(bmi[32] | bmi[33] << 8 | bmi[34] << 16);
-    const uint8_t *after = bmi + size;
-    int is555 = !(comp == 3 && (after[4] | after[5] << 8) == 0x07E0);
-    uint32_t handle = hle_gdi_make_dib(w, hab, bpp, (uint8_t *)bits, h < 0, bpp <= 8 ? (const uint32_t *)after : NULL,
-                                       bpp <= 8 ? (int)(used ? used : 1u << bpp) : 0, is555);
-    if (!handle) handle = g_next_handle++;
-    if (g_dib_n < MAX_DIBS) {
-        g_dibs[g_dib_n].h = handle;
-        g_dibs[g_dib_n].bits = bits; g_dibs[g_dib_n].w = w;
-        g_dibs[g_dib_n].h_abs = hab; g_dibs[g_dib_n].topdown = h < 0;
-        g_dib_n++;
+    if (bits_out) *bits_out = NULL;
+    if (!bmi) { hle_set_last_error(87); return 0; }
+    uint32_t header = bitmap_u32(bmi);
+    if (!(header == 40 || header == 52 || header == 56 || header == 108 || header == 124)) {
+        hle_set_last_error(87); return 0;
     }
+    int w = bi_w(bmi), h = bi_h(bmi), bpp = bi_bpp(bmi), height, pitch;
+    uint32_t bytes, compression = bitmap_u32(bmi + 16), used = bitmap_u32(bmi + 32);
+    unsigned planes = (unsigned)bmi[12] | (unsigned)bmi[13] << 8;
+    if (planes != 1 || !civ3_bitmap_layout(w, h, (uint32_t)bpp, &height, &pitch, &bytes) ||
+        !(compression == 0 || (compression == 3 && (bpp == 16 || bpp == 32))) ||
+        (bpp <= 8 && used > (1u << bpp))) {
+        hle_set_last_error(87); return 0;
+    }
+    if (g_dib_n >= MAX_DIBS) { hle_set_last_error(8); return 0; }
+    /* Keep the prior guard DWORD for packed pixel reads. Check all arithmetic
+     * before converting to the guest allocator's 32-bit byte count. */
+    uint32_t *bits = (uint32_t *)hle_alloc(bytes + 4u);
+    if (!bits) { hle_set_last_error(8); return 0; }
+    const uint8_t *colors = bmi + header;
+    const uint8_t *masks = bmi + 40; /* embedded in V2/V3/V4/V5, follows INFO */
+    int is555 = !(compression == 3 && bitmap_u32(masks + 4) == 0x07E0u);
+    uint32_t handle = hle_gdi_make_dib(w, height, bpp, (uint8_t *)bits, h < 0,
+                                     bpp <= 8 ? (const uint32_t *)colors : NULL,
+                                     bpp <= 8 ? (int)(used ? used : 1u << bpp) : 0, is555);
+    if (!handle) {
+        hle_free(bits); hle_set_last_error(8); return 0;
+    }
+    /* Never fabricate a handle without a selectable object, or an allocation
+     * that cannot subsequently be found and released by DeleteObject. */
+    g_dibs[g_dib_n].h = handle;
+    g_dibs[g_dib_n].bits = bits;
+    g_dibs[g_dib_n].w = w;
+    g_dibs[g_dib_n].h_abs = height;
+    g_dibs[g_dib_n].topdown = h < 0;
+    ++g_dib_n;
     if (bits_out) *bits_out = bits;
     return handle;
 }
