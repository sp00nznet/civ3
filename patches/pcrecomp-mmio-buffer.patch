+    if (!m->io_set) return;
+    if (m->capacity && pos >= m->window && pos-m->window <= m->valid) {
+        m->next = pos-m->window;
+    } else {
+        m->window = m->disk = pos;
+        m->valid = m->next = 0;
+    }
