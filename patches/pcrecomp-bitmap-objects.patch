+static uint32_t make_owned_bitmap(int w, int h, uint32_t bits) {
+    int height, pitch; uint32_t bytes;
+    /* Preserve the shim's existing internal format normalization. In
+     * particular a 24-bit request uses 32-bit storage, not a 3-byte buffer
+     * later written through 4-byte pixels. Initial lpBits semantics are
+     * unchanged by this allocation-safety repair. */
+    if (!(bits == 1 || bits == 4 || bits == 8 || bits == 16 || bits == 24 || bits == 32) || w < 0 || h < 0) {
+        hle_set_last_error(87); return 0;
+    }
+    if (!w || !h) w = h = 1;
+    uint32_t stored_bits = bits == 24 ? 32 : bits < 8 ? 8 : bits;
+    if (!civ3_bitmap_layout(w, h, stored_bits, &height, &pitch, &bytes)) {
+        hle_set_last_error(87); return 0;
+    }
+    uint8_t *pixels = (uint8_t *)calloc(1, bytes);
+    if (!pixels) { hle_set_last_error(8); return 0; }
+    return hle_gdi_make_bitmap(w, h, (int)stored_bits, pixels, 1);
+}
+static void g_CreateCompatibleBitmap(void) {
+    RET(make_owned_bitmap((int)A32(1), (int)A32(2), 32), 3);
+}
+static void g_CreateBitmap(void) {
+    if (A32(2) != 1) { hle_set_last_error(87); RET(0, 5); }
+    RET(make_owned_bitmap((int)A32(0), (int)A32(1), A32(3)), 5);
 }
 
