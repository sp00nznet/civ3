+static float g_sfx_output_gain = 1.0f;
+static void configure_sfx_guard(void) {
+    const char *disable = getenv("CIV3_DISABLE_SFX_GUARD");
+    const char *diagnostics = getenv("CIV3_SFX_GUARD_LOG");
+    const char *output = getenv("CIV3_SFX_OUTPUT_GAIN");
+    g_sfx_guard_disabled = disable && disable[0] && strcmp(disable, "0");
+    g_sfx_guard_log = diagnostics && diagnostics[0] && strcmp(diagnostics, "0");
+    /* WAV input is pre-scaled to prevent overflow inside the guest. Restore
+     * part of the perceived volume at the very end of the sound pipeline. */
+    if (output && output[0]) {
+        char *end = NULL;
+        float requested = strtof(output, &end);
+        if (end != output && !*end && requested >= 1.0f && requested <= 3.0f)
+            g_sfx_output_gain = requested;
+    }
+}
