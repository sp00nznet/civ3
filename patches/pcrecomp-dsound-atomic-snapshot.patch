-static void b_Unlock(void) { RET(DS_OK, 5); }            /* (this, p1, n1, p2, n2): the memory is the buffer */
+/* DirectSound Lock hands guest code a writable PCM region. SDL runs its audio
+ * callback concurrently with that guest write: reading the source directly
+ * makes it possible to play torn 16-bit samples and old/new mixed frames.
+ * The snapshot is shared across duplicate COM buffers, but only refreshed
+ * after the game finishes the transaction by calling Unlock.
+ */
+static int dsound_commit_guest_pcm(dsbuf *b, uint32_t p1, uint32_t n1,
+                                   uint32_t p2, uint32_t n2) {
+    if (!b || !b->data || !b->play_data || b->primary) return 0;
+    uint32_t base = hle_va(b->data);
+    if (p1 < base || p1-base > b->bytes || n1 > b->bytes-(p1-base) ||
+        n2 > b->bytes || (n2 && p2 != base) ||
+        ((uint64_t)n1 + n2 > b->bytes)) return 0;
+    pthread_mutex_lock(&g_mix);
+    if (n1) memcpy(b->play_data + (p1-base), b->data + (p1-base), n1);
+    if (n2) memcpy(b->play_data, b->data, n2);
+    pthread_mutex_unlock(&g_mix);
+    return 1;
+}
+static void b_Unlock(void) {
+    dsbuf *b = buf_of(A32(0));
+    RET(dsound_commit_guest_pcm(b, A32(1), A32(2), A32(3), A32(4)) ?
+        DS_OK : DSERR_INVALIDPARAM, 5);
+}
+#ifdef CIV3_TEST_AUDIO_SNAPSHOT
+/* Read-only test hook. This is not present in production game binaries. */
+int hle_dsound_snapshot_for_test(uint32_t self, uint32_t offset,
+                                uint8_t *dst, uint32_t n) {
+    dsbuf *b = buf_of(self);
+    if (!b || !dst || !b->play_data || offset > b->bytes ||
+        n > b->bytes-offset) return 0;
+    pthread_mutex_lock(&g_mix);
+    memcpy(dst, b->play_data+offset, n);
+    pthread_mutex_unlock(&g_mix);
+    return 1;
+}
+#endif
