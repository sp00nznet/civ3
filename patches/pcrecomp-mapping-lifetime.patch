-#define MAX_VIEWS 64
-static struct { uint32_t addr, len; } g_views[MAX_VIEWS];
+/* Views may survive a file HANDLE close. Keep a dynamically sized table:
+ * reserving a 65th view without a slot formerly leaked inaccessible guest
+ * mappings. A separate mutex keeps map/unmap atomic for host audio workers
+ * that can call guest Win32 APIs from another native thread. */
+typedef struct { uint32_t addr, len; } map_view_t;
+static map_view_t *g_views;
+static size_t g_views_capacity;
+static pthread_mutex_t g_views_mutex = PTHREAD_MUTEX_INITIALIZER;
+#define MAX_TRACKED_VIEWS 4096u
+
+static int allocate_view_slot_locked(void) {
+    for (size_t i = 0; i < g_views_capacity; i++)
+        if (!g_views[i].addr) return (int)i;
+    if (g_views_capacity >= MAX_TRACKED_VIEWS) return -1;
+    size_t next = g_views_capacity ? g_views_capacity * 2 : 64;
+    if (next > MAX_TRACKED_VIEWS) next = MAX_TRACKED_VIEWS;
+    map_view_t *new_views = (map_view_t *)realloc(g_views, next * sizeof *g_views);
+    if (!new_views) return -1;
+    memset(new_views + g_views_capacity, 0,
+           (next - g_views_capacity) * sizeof *new_views);
+    int index = (int)g_views_capacity;
+    g_views = new_views;
+    g_views_capacity = next;
+    return index;
+}
